# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored. Never commit real keys.

# Supabase project URL (Project Settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Server-only secret key (sb_secret_… or the legacy service_role key).
# Used only by /api functions. It must never reach browser JavaScript.
SUPABASE_SECRET_KEY=

# Not used by this MVP (the browser never talks to Supabase directly).
# SUPABASE_PUBLISHABLE_KEY=

# Base URL used when printing access links from scripts/create-project.js
APP_BASE_URL=http://localhost:3000

# Local development without Supabase: set DATA_DRIVER=file to store data
# in .data/db.json instead. Defaults to "supabase" when SUPABASE_URL is set.
# DATA_DRIVER=file
